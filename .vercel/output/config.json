			"dest": "_render"
		},
		{
			"src": "^/photography-classes/?$",
			"dest": "_render"
		},
		{
			"src": "^/QuizProgram/find-your-program/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}

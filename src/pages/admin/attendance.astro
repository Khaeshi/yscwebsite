---
import AdminLayout from '../../layouts/AdminLayout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role !== 'admin' && user.role !== 'superadmin') return Astro.redirect('/admin/teacher/dashboard');
---

<AdminLayout title="Attendance | YSC Admin" description="Attendance log">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:18px;">
    <div>
      <h1 style="font-size:24px;font-weight:700;color:#f1f5f9;margin:0 0 4px;">Attendance</h1>
      <p style="font-size:13px;color:#475569;margin:0;">Full attendance log with filters and teacher-level visibility.</p>
    </div>
  </div>

  <section style="background:#16162a;border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:14px 14px;margin-bottom:14px;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr auto;gap:10px;">
      <input id="filter-from" type="date" style="background:#0d0d1a;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:9px 10px;color:#e2e8f0;" />
      <input id="filter-to" type="date" style="background:#0d0d1a;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:9px 10px;color:#e2e8f0;" />
      <select id="filter-status" style="background:#0d0d1a;border:1px solid rgba(255,255,255,0.08);border-radius:10px;padding:9px 10px;color:#e2e8f0;">
        <option value="">All status</option>
        <option value="pending">Pending</option>
        <option value="attended">Attended</option>
        <option value="absent">Absent</option>
        <option value="cancelled">Cancelled</option>
      </select>
      <button id="apply-filter" style="background:linear-gradient(135deg,#7c3aed,#db2777);border:none;color:white;border-radius:10px;padding:9px 12px;font-weight:700;cursor:pointer;">Apply</button>
    </div>
  </section>

  <section style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin-bottom:14px;">
    <div style="background:#16162a;border:1px solid rgba(255,255,255,0.06);border-radius:14px;padding:12px;">
      <p style="margin:0;font-size:11px;color:#64748b;">Total Sessions</p>
      <p id="sum-total" style="margin:4px 0 0;font-size:24px;font-weight:700;color:#e2e8f0;">0</p>
    </div>
    <div style="background:#16162a;border:1px solid rgba(255,255,255,0.06);border-radius:14px;padding:12px;">
      <p style="margin:0;font-size:11px;color:#64748b;">Attended %</p>
      <p id="sum-attended-pct" style="margin:4px 0 0;font-size:24px;font-weight:700;color:#22c55e;">0%</p>
    </div>
    <div style="background:#16162a;border:1px solid rgba(255,255,255,0.06);border-radius:14px;padding:12px;">
      <p style="margin:0;font-size:11px;color:#64748b;">Absent Count</p>
      <p id="sum-absent" style="margin:4px 0 0;font-size:24px;font-weight:700;color:#f59e0b;">0</p>
    </div>
  </section>

  <section style="background:#16162a;border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:18px;">
    <div style="overflow:auto;border-radius:12px;border:1px solid rgba(255,255,255,0.06);">
      <table style="width:100%;border-collapse:collapse;font-size:12px;">
        <thead style="background:#11111f;color:#94a3b8;">
          <tr>
            <th style="text-align:left;padding:10px 12px;">Teacher</th>
            <th style="text-align:left;padding:10px 12px;">Student</th>
            <th style="text-align:left;padding:10px 12px;">Subject</th>
            <th style="text-align:left;padding:10px 12px;">Date</th>
            <th style="text-align:left;padding:10px 12px;">Status</th>
            <th style="text-align:left;padding:10px 12px;">Marked At</th>
          </tr>
        </thead>
        <tbody id="attendance-body" style="background:#0d0d1a;color:#cbd5e1;">
          <tr><td colspan="6" style="padding:14px 12px;color:#64748b;">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <script>
    const body = document.getElementById('attendance-body');
    const fromEl = document.getElementById('filter-from');
    const toEl = document.getElementById('filter-to');
    const statusEl = document.getElementById('filter-status');
    const applyBtn = document.getElementById('apply-filter');
    const sumTotal = document.getElementById('sum-total');
    const sumAttendedPct = document.getElementById('sum-attended-pct');
    const sumAbsent = document.getElementById('sum-absent');

    function badge(status) {
      const map = {
        pending: ['Pending', '#60a5fa', 'rgba(96,165,250,0.14)'],
        attended: ['Attended', '#22c55e', 'rgba(34,197,94,0.14)'],
        absent: ['Absent', '#f59e0b', 'rgba(245,158,11,0.14)'],
        cancelled: ['Cancelled', '#94a3b8', 'rgba(148,163,184,0.14)'],
      };
      const [text, fg, bg] = map[status] ?? map.pending;
      return `<span style="display:inline-flex;padding:4px 10px;border-radius:999px;background:${bg};color:${fg};font-weight:700;font-size:11px;">${text}</span>`;
    }

    function fmtDate(d) {
      if (!d) return '';
      return new Date(d).toLocaleDateString();
    }

    function fmtDateTime(d) {
      if (!d) return '—';
      return new Date(d).toLocaleString();
    }

    async function load() {
      const params = new URLSearchParams();
      if (fromEl.value) params.set('from', fromEl.value);
      if (toEl.value) params.set('to', toEl.value);
      if (statusEl.value) params.set('status', statusEl.value);
      const res = await fetch(`/api/attendance/log?${params.toString()}`);
      const data = await res.json().catch(() => ({}));
      if (!data.success) {
        body.innerHTML = `<tr><td colspan="6" style="padding:14px 12px;color:#ef4444;">Failed to load logs.</td></tr>`;
        return;
      }

      const logs = data.logs ?? [];
      if (!logs.length) {
        body.innerHTML = `<tr><td colspan="6" style="padding:14px 12px;color:#64748b;">No attendance logs found.</td></tr>`;
      } else {
        body.innerHTML = logs.map((log) => `
          <tr style="border-top:1px solid rgba(255,255,255,0.06);">
            <td style="padding:10px 12px;">${log.teacherName ?? ''}</td>
            <td style="padding:10px 12px;">${log.studentName ?? ''}</td>
            <td style="padding:10px 12px;">${log.subject ?? ''}</td>
            <td style="padding:10px 12px;">${fmtDate(log.scheduledDate)}</td>
            <td style="padding:10px 12px;">${badge(log.status)}</td>
            <td style="padding:10px 12px;">${fmtDateTime(log.markedAt)}</td>
          </tr>
        `).join('');
      }

      const total = logs.length;
      const attended = logs.filter((x) => x.status === 'attended').length;
      const absent = logs.filter((x) => x.status === 'absent').length;
      sumTotal.textContent = String(total);
      sumAbsent.textContent = String(absent);
      sumAttendedPct.textContent = total ? `${Math.round((attended / total) * 100)}%` : '0%';
    }

    applyBtn?.addEventListener('click', load);
    load();
  </script>
</AdminLayout>


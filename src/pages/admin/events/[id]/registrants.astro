---
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { connectDB } from '../../../../lib/db/client.js';
import Event from '../../../../lib/db/models/Event.js';
import Registration from '../../../../lib/db/models/Registration.js';
import RegistrationChart from '../../../../components/admin/RegistrationChart.tsx';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');

await connectDB();
const event = await Event.findById(Astro.params.id).lean() as any;
if (!event) return Astro.redirect('/admin/events');

// Load registrations server-side for chart data
const registrations = await Registration.find({ eventId: event._id }).lean() as any[];

// Build chart data server-side
const dayMap: Record<string, number> = {};
registrations.forEach((r: any) => {
  const day = new Date(r.createdAt).toLocaleDateString('en-PH', { month: 'short', day: 'numeric' });
  dayMap[day] = (dayMap[day] ?? 0) + 1;
});
const chartData = Object.entries(dayMap).map(([day, count]) => ({ day, count }));

const eventId    = String(event._id);
const eventTitle = String(event.title);
const instrument = String(event.instrument ?? '');
---

<AdminLayout title={`${eventTitle} — Registrants | YSC`} description="Event Registrants">

  <div id="page-data" data-event-id={eventId} data-event-title={eventTitle} class="hidden"></div>

  <div class="w-full">

    <!-- Breadcrumb -->
    <div class="flex items-center gap-2 mb-4 text-sm flex-wrap">
      <a href="/admin/events" class="text-gray-400 hover:text-purple-600 transition-colors flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Events
      </a>
      <span class="text-gray-300">/</span>
      <span class="text-gray-600 font-medium truncate max-w-[200px] sm:max-w-none">{eventTitle}</span>
    </div>

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-6">
      <div>
        <h1 class="text-xl sm:text-2xl font-bold text-gray-900 leading-tight">{eventTitle}</h1>
        <p class="text-sm text-gray-500 mt-0.5">
          {instrument && <span class="text-purple-600 font-medium">🎵 {instrument} · </span>}
          Registrants
        </p>
      </div>
      <button id="export-btn"
        class="inline-flex items-center justify-center gap-2 border border-gray-200 bg-white hover:bg-gray-50 text-gray-700 px-4 py-2 rounded-xl text-sm font-semibold transition-colors w-full sm:w-auto">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
        </svg>
        Export CSV
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <p class="text-xs text-gray-500 font-medium">Total</p>
        <p id="s-total" class="text-2xl font-bold text-gray-900 mt-1">—</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <p class="text-xs text-gray-500 font-medium">Pending</p>
        <p id="s-pending" class="text-2xl font-bold text-amber-500 mt-1">—</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <p class="text-xs text-gray-500 font-medium">Approved</p>
        <p id="s-approved" class="text-2xl font-bold text-green-600 mt-1">—</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-4">
        <p class="text-xs text-gray-500 font-medium">Rejected</p>
        <p id="s-rejected" class="text-2xl font-bold text-red-500 mt-1">—</p>
      </div>
    </div>

    <!-- Chart — React component with Recharts -->
    <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
      <h2 class="text-sm font-bold text-gray-700 mb-4">Registration Timeline</h2>
      <RegistrationChart data={chartData} client:load />
    </div>

    <!-- Filter tabs + Table -->
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">

      <!-- Tabs -->
      <div class="px-4 sm:px-5 py-3.5 border-b border-gray-100 flex items-center gap-2 overflow-x-auto">
        <button class="filter-tab active shrink-0" data-filter="all">All</button>
        <button class="filter-tab shrink-0" data-filter="pending">Pending</button>
        <button class="filter-tab shrink-0" data-filter="approved">Approved</button>
        <button class="filter-tab shrink-0" data-filter="rejected">Rejected</button>
      </div>

      <!-- Loading -->
      <div id="tbl-loading" class="py-12 text-center">
        <div class="w-6 h-6 border-2 border-purple-500 border-t-transparent rounded-full animate-spin mx-auto"></div>
      </div>

      <!-- Empty -->
      <div id="tbl-empty" class="hidden py-12 text-center text-sm text-gray-400">
        No registrants yet
      </div>

      <!-- Desktop table -->
      <div id="tbl-wrapper" class="hidden overflow-x-auto">
        <table class="w-full text-sm min-w-[700px]">
          <thead class="bg-gray-50 border-b border-gray-100">
            <tr>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Name</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Contact</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Age</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Guardian</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Interest</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Date</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Status</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase whitespace-nowrap">Actions</th>
            </tr>
          </thead>
          <tbody id="tbl-body" class="divide-y divide-gray-50"></tbody>
        </table>
      </div>

      <!-- Mobile cards -->
      <div id="mob-cards" class="hidden divide-y divide-gray-100"></div>
    </div>
  </div>
</AdminLayout>

<!-- Action modal -->
<div id="action-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" id="action-backdrop"></div>
  <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-sm p-6">
    <h3 id="action-title" class="text-base font-bold text-gray-900 mb-1"></h3>
    <p id="action-desc"  class="text-sm text-gray-500 mb-4"></p>
    <div class="mb-4">
      <label class="block text-xs font-semibold text-gray-500 uppercase mb-1.5">Internal Note (optional)</label>
      <textarea id="action-note" rows="2" placeholder="e.g. Slots are full"
        class="w-full text-sm border border-gray-200 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-purple-500 resize-none"></textarea>
    </div>
    <div class="flex gap-3">
      <button id="action-cancel"  class="flex-1 px-4 py-2 border border-gray-200 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</button>
      <button id="action-confirm" class="flex-1 px-4 py-2 text-white rounded-lg text-sm font-semibold transition-colors">Confirm</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-5 left-1/2 -translate-x-1/2 sm:left-auto sm:right-5 sm:translate-x-0 z-50 hidden">
  <div class="bg-gray-900 text-white text-sm font-medium px-4 py-3 rounded-xl shadow-lg flex items-center gap-2 whitespace-nowrap">
    <span id="toast-icon"></span>
    <span id="toast-msg"></span>
  </div>
</div>

<style>
  .filter-tab {
    padding: 5px 14px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 600;
    border: 1px solid #e5e7eb;
    background: white;
    color: #6b7280;
    cursor: pointer;
    transition: all 0.15s;
    text-transform: capitalize;
  }
  .filter-tab.active {
    background: #7c3aed;
    color: white;
    border-color: #7c3aed;
  }
</style>

<script>
  const pageData    = document.getElementById('page-data') as HTMLElement;
  const EVENT_ID    = pageData.dataset.eventId ?? '';
  const EVENT_TITLE = pageData.dataset.eventTitle ?? '';

  interface Registration {
    _id: string; fullName: string; email: string; phone: string;
    dateOfBirth: string; parentGuardian: string; instrumentInterest: string;
    status: 'pending' | 'approved' | 'rejected';
    createdAt: string; confirmedAt: string | null;
  }

  let allRegs: Registration[]             = [];
  let activeFilter                        = 'all';
  let pendingAction: { id: string; status: 'approved' | 'rejected' } | null = null;

  function showToast(msg: string, ok = true) {
    const t = document.getElementById('toast')!;
    document.getElementById('toast-icon')!.textContent = ok ? '✅' : '❌';
    document.getElementById('toast-msg')!.textContent  = msg;
    t.classList.remove('hidden');
    setTimeout(() => t.classList.add('hidden'), 3500);
  }

  function calcAge(dob: string) {
    return Math.floor((Date.now() - new Date(dob).getTime()) / (1000 * 60 * 60 * 24 * 365.25));
  }

  function fmtDate(d: string) {
    return new Date(d).toLocaleDateString('en-PH', { year: 'numeric', month: 'short', day: 'numeric' });
  }

  function statusBadge(s: string) {
    const map: Record<string, string> = {
      pending:  'bg-amber-100 text-amber-700',
      approved: 'bg-green-100 text-green-700',
      rejected: 'bg-red-100 text-red-500',
    };
    return `<span class="inline-flex px-2.5 py-0.5 rounded-full text-xs font-semibold ${map[s] ?? ''} capitalize">${s}</span>`;
  }

  async function loadRegistrants() {
    const res  = await fetch(`/api/registrations?eventId=${EVENT_ID}`);
    const data = await res.json();
    allRegs    = data.registrations ?? [];
    updateStats();
    renderTable();
  }

  function updateStats() {
    document.getElementById('s-total')!.textContent    = String(allRegs.length);
    document.getElementById('s-pending')!.textContent  = String(allRegs.filter(r => r.status === 'pending').length);
    document.getElementById('s-approved')!.textContent = String(allRegs.filter(r => r.status === 'approved').length);
    document.getElementById('s-rejected')!.textContent = String(allRegs.filter(r => r.status === 'rejected').length);
  }

  function renderTable() {
    const filtered = activeFilter === 'all'
      ? allRegs
      : allRegs.filter(r => r.status === activeFilter);

    document.getElementById('tbl-loading')!.classList.add('hidden');

    if (filtered.length === 0) {
      document.getElementById('tbl-empty')!.classList.remove('hidden');
      document.getElementById('tbl-wrapper')!.classList.add('hidden');
      document.getElementById('mob-cards')!.classList.add('hidden');
      return;
    }

    document.getElementById('tbl-empty')!.classList.add('hidden');

    // ── Desktop table ──
    document.getElementById('tbl-wrapper')!.classList.remove('hidden');
    document.getElementById('tbl-body')!.innerHTML = filtered.map(r => `
      <tr class="hover:bg-gray-50 transition-colors">
        <td class="px-4 py-3 font-medium text-gray-900 whitespace-nowrap">${r.fullName}</td>
        <td class="px-4 py-3">
          <div class="text-gray-700 text-xs">${r.email}</div>
          <div class="text-gray-400 text-xs mt-0.5">${r.phone}</div>
        </td>
        <td class="px-4 py-3 text-gray-600 whitespace-nowrap">${r.dateOfBirth ? calcAge(r.dateOfBirth) + ' yrs' : '—'}</td>
        <td class="px-4 py-3 text-gray-600 whitespace-nowrap">${r.parentGuardian}</td>
        <td class="px-4 py-3 text-gray-500 max-w-[120px] truncate">${r.instrumentInterest || '—'}</td>
        <td class="px-4 py-3 text-gray-500 whitespace-nowrap text-xs">${fmtDate(r.createdAt)}</td>
        <td class="px-4 py-3">${statusBadge(r.status)}</td>
        <td class="px-4 py-3">
          <div class="flex items-center gap-1.5">
            ${r.status !== 'approved' ? `<button data-action="approve" data-id="${r._id}" data-name="${r.fullName}" class="px-2.5 py-1 text-xs font-semibold bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors whitespace-nowrap">Approve</button>` : ''}
            ${r.status !== 'rejected' ? `<button data-action="reject"  data-id="${r._id}" data-name="${r.fullName}" class="px-2.5 py-1 text-xs font-semibold bg-red-100 text-red-600 rounded-lg hover:bg-red-200 transition-colors">Reject</button>`  : ''}
          </div>
        </td>
      </tr>
    `).join('');

    // ── Mobile cards ──
    document.getElementById('mob-cards')!.classList.remove('hidden');
    document.getElementById('mob-cards')!.innerHTML = filtered.map(r => `
      <div class="p-4">
        <div class="flex items-start justify-between gap-3 mb-2">
          <div>
            <p class="font-semibold text-gray-900 text-sm">${r.fullName}</p>
            <p class="text-xs text-gray-500 mt-0.5">${r.email}</p>
            <p class="text-xs text-gray-400">${r.phone}</p>
          </div>
          ${statusBadge(r.status)}
        </div>
        <div class="grid grid-cols-2 gap-x-4 gap-y-1 text-xs text-gray-500 mb-3">
          <span>Age: ${r.dateOfBirth ? calcAge(r.dateOfBirth) + ' yrs' : '—'}</span>
          <span>Guardian: ${r.parentGuardian}</span>
          <span>Interest: ${r.instrumentInterest || '—'}</span>
          <span>Registered: ${fmtDate(r.createdAt)}</span>
        </div>
        <div class="flex gap-2">
          ${r.status !== 'approved' ? `<button data-action="approve" data-id="${r._id}" data-name="${r.fullName}" class="flex-1 py-1.5 text-xs font-semibold bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">Approve</button>` : ''}
          ${r.status !== 'rejected' ? `<button data-action="reject"  data-id="${r._id}" data-name="${r.fullName}" class="flex-1 py-1.5 text-xs font-semibold bg-red-100 text-red-600 rounded-lg hover:bg-red-200 transition-colors">Reject</button>`  : ''}
        </div>
      </div>
    `).join('');

    // Attach action listeners to both table and cards
    document.querySelectorAll<HTMLButtonElement>('[data-action]').forEach(btn => {
      btn.addEventListener('click', () => {
        openActionModal(btn.dataset.id ?? '', btn.dataset.action ?? '', btn.dataset.name ?? '');
      });
    });
  }

  // Filter tabs
  document.querySelectorAll<HTMLButtonElement>('.filter-tab').forEach(btn => {
    btn.addEventListener('click', () => {
      activeFilter = btn.dataset.filter ?? 'all';
      document.querySelectorAll<HTMLButtonElement>('.filter-tab').forEach(b => {
        b.classList.toggle('active', b.dataset.filter === activeFilter);
      });
      renderTable();
    });
  });

  // Action modal
  function openActionModal(id: string, action: string, name: string) {
    pendingAction = { id, status: action === 'approve' ? 'approved' : 'rejected' };

    document.getElementById('action-title')!.textContent = action === 'approve' ? `Approve ${name}?` : `Reject ${name}?`;
    document.getElementById('action-desc')!.textContent  = action === 'approve'
      ? 'A confirmation email will be sent to the registrant.'
      : 'The registrant will not receive an email for rejections.';
    (document.getElementById('action-note') as HTMLTextAreaElement).value = '';

    const confirmBtn      = document.getElementById('action-confirm') as HTMLButtonElement;
    confirmBtn.textContent = action === 'approve' ? 'Approve & Send Email' : 'Reject';
    confirmBtn.className   = `flex-1 px-4 py-2 text-white rounded-lg text-sm font-semibold transition-colors ${
      action === 'approve' ? 'bg-green-600 hover:bg-green-700' : 'bg-red-600 hover:bg-red-700'
    }`;

    const modal = document.getElementById('action-modal')!;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeActionModal() {
    const modal = document.getElementById('action-modal')!;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    pendingAction = null;
  }

  document.getElementById('action-cancel')!.addEventListener('click', closeActionModal);
  document.getElementById('action-backdrop')!.addEventListener('click', closeActionModal);

  document.getElementById('action-confirm')!.addEventListener('click', async () => {
    if (!pendingAction) return;
    const btn  = document.getElementById('action-confirm') as HTMLButtonElement;
    const note = (document.getElementById('action-note') as HTMLTextAreaElement).value.trim();
    btn.disabled = true; btn.textContent = 'Saving...';
    try {
      const res  = await fetch(`/api/registrations/${pendingAction.id}`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: pendingAction.status, statusNote: note }),
      });
      const data = await res.json();
      if (data.success) {
        const idx = allRegs.findIndex(r => r._id === pendingAction?.id);
        if (idx !== -1) allRegs[idx] = { ...allRegs[idx], ...data.registration };
        updateStats(); renderTable(); closeActionModal();
        showToast(pendingAction.status === 'approved' ? 'Approved — confirmation email sent' : 'Registration rejected');
      } else { showToast(data.message, false); }
    } catch { showToast('Action failed', false); }
    finally  { btn.disabled = false; }
  });

  // CSV export
  document.getElementById('export-btn')!.addEventListener('click', () => {
    if (allRegs.length === 0) { showToast('No registrants to export', false); return; }
    const headers = ['Full Name','Email','Phone','Date of Birth','Age','Parent/Guardian','Instrument Interest','Status','Registered On'];
    const rows    = allRegs.map(r => [
      r.fullName, r.email, r.phone,
      r.dateOfBirth ? new Date(r.dateOfBirth).toLocaleDateString('en-PH') : '',
      r.dateOfBirth ? String(calcAge(r.dateOfBirth)) : '',
      r.parentGuardian, r.instrumentInterest ?? '', r.status,
      new Date(r.createdAt).toLocaleDateString('en-PH'),
    ]);
    const csv  = [headers, ...rows].map(row => row.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
    const blob = new Blob([csv], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = Object.assign(document.createElement('a'), { href: url, download: `${EVENT_TITLE.replace(/[^a-z0-9]/gi,'_')}_registrants.csv` });
    a.click();
    URL.revokeObjectURL(url);
    showToast('Exported successfully');
  });

  loadRegistrants();
</script>
---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
---

<AdminLayout title="Events | YSC Admin" description="Manage Events">
  <div class="max-w-7xl mx-auto">

    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6 sm:mb-8">
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Events</h1>
        <p class="text-sm text-gray-500 mt-1">Create and manage public registration events</p>
      </div>
      <button id="new-event-btn"
        class="inline-flex items-center justify-center gap-2 bg-purple-600 hover:bg-purple-700 text-white px-4 py-2.5 rounded-xl font-semibold text-sm transition-colors shadow-sm">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
        </svg>
        New Event
      </button>
    </div>

    <!-- Stats -->
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4 mb-6">
      <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5">
        <p class="text-xs text-gray-500 font-medium">Total Events</p>
        <p id="stat-total" class="text-2xl font-bold text-gray-900 mt-1">—</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5">
        <p class="text-xs text-gray-500 font-medium">Published</p>
        <p id="stat-published" class="text-2xl font-bold text-green-600 mt-1">—</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5">
        <p class="text-xs text-gray-500 font-medium">Total Registrants</p>
        <p id="stat-registrants" class="text-2xl font-bold text-purple-600 mt-1">—</p>
      </div>
      <div class="bg-white rounded-xl border border-gray-200 p-4 sm:p-5">
        <p class="text-xs text-gray-500 font-medium">Pending Review</p>
        <p id="stat-pending" class="text-2xl font-bold text-amber-500 mt-1">—</p>
      </div>
    </div>

    <!-- Events grid -->
    <div id="loading" class="py-16 text-center">
      <div class="w-8 h-8 border-2 border-purple-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
      <p class="text-sm text-gray-400">Loading events...</p>
    </div>
    <div id="empty" class="hidden py-16 text-center bg-white rounded-xl border border-gray-200">
      <div class="text-4xl mb-3">🎪</div>
      <p class="font-semibold text-gray-700">No events yet</p>
      <p class="text-sm text-gray-400 mt-1 mb-4">Create your first event to start accepting registrations</p>
      <button id="new-event-btn-2" class="bg-purple-600 text-white px-5 py-2 rounded-xl text-sm font-semibold hover:bg-purple-700 transition-colors">Create Event</button>
    </div>
    <div id="events-grid" class="hidden grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4"></div>
  </div>
</AdminLayout>

<!-- Create/Edit Modal -->
<div id="event-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" id="modal-backdrop"></div>
  <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[92vh] overflow-y-auto">
    <div class="sticky top-0 bg-white border-b border-gray-100 px-6 py-4 flex items-center justify-between z-10 rounded-t-2xl">
      <h2 id="modal-title" class="text-lg font-bold text-gray-900">New Event</h2>
      <button id="modal-close" class="p-2 rounded-lg hover:bg-gray-100 text-gray-500 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="p-6 space-y-5">
      <!-- Cover photo -->
      <div>
        <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">Cover Photo</label>
        <div id="cover-drop" class="relative border-2 border-dashed border-gray-200 rounded-xl overflow-hidden cursor-pointer hover:border-purple-400 transition-colors">
          <img id="cover-preview" class="w-full h-40 object-cover hidden" alt="Cover preview" />
          <div id="cover-placeholder" class="flex flex-col items-center justify-center h-40 gap-2">
            <svg class="w-8 h-8 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <p class="text-sm text-gray-400">Click or drag to upload</p>
            <p class="text-xs text-gray-300">JPEG, PNG, WebP · Max 5MB</p>
          </div>
          <input type="file" id="cover-input" accept="image/jpeg,image/png,image/webp" class="absolute inset-0 opacity-0 cursor-pointer" />
          <div id="upload-progress" class="hidden absolute inset-0 bg-white/80 flex items-center justify-center">
            <div class="w-6 h-6 border-2 border-purple-500 border-t-transparent rounded-full animate-spin"></div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Event Title <span class="text-red-400">*</span></label>
          <input id="f-title" type="text" placeholder="e.g. Summer Class: Piano" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Instrument</label>
          <input id="f-instrument" type="text" placeholder="e.g. Piano" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Status</label>
          <select id="f-status" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
            <option value="closed">Closed</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Start Date</label>
          <input id="f-startDate" type="date" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">End Date</label>
          <input id="f-endDate" type="date" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Max Slots</label>
          <input id="f-maxSlots" type="number" min="1" placeholder="Leave blank for unlimited" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Location</label>
          <input id="f-location" type="text" placeholder="e.g. YSC Studio, Quezon City" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Schedule Info</label>
          <input id="f-schedule" type="text" placeholder="Morning sessions only (8:00 AM – 12:00 PM)" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Contact Phone</label>
          <input id="f-phone" type="text" placeholder="+63 912 345 6789" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div>
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Contact Email</label>
          <input id="f-contactEmail" type="email" placeholder="info@youngstarterclub.com" class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500" />
        </div>
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-gray-500 uppercase tracking-wide mb-1.5">Description</label>
          <textarea id="f-description" rows="4" placeholder="Tell students what this event is about..." class="w-full border border-gray-200 rounded-lg px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-purple-500 resize-none"></textarea>
        </div>
      </div>

      <div id="modal-error" class="hidden p-3 bg-red-50 border border-red-200 rounded-lg text-sm text-red-600"></div>
      <div class="flex gap-3 pt-2">
        <button id="modal-cancel" class="flex-1 px-4 py-2.5 border border-gray-200 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-colors">Cancel</button>
        <button id="modal-save"   class="flex-1 px-4 py-2.5 bg-purple-600 text-white rounded-xl text-sm font-semibold hover:bg-purple-700 transition-colors">Save Event</button>
      </div>
    </div>
  </div>
</div>

<!-- Delete confirm -->
<div id="delete-modal" class="fixed inset-0 z-50 hidden items-center justify-center p-4">
  <div class="absolute inset-0 bg-black/50 backdrop-blur-sm"></div>
  <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-sm p-6">
    <h3 class="text-base font-bold text-gray-900 mb-2">Delete Event?</h3>
    <p class="text-sm text-gray-500 mb-1">This will permanently delete <strong id="delete-event-name"></strong> and all its registration data.</p>
    <p class="text-sm text-red-500 bg-red-50 rounded-lg px-3 py-2 mb-5">This action cannot be undone.</p>
    <div class="flex gap-3">
      <button id="delete-cancel"  class="flex-1 px-4 py-2 border border-gray-200 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-50">Cancel</button>
      <button id="delete-confirm" class="flex-1 px-4 py-2 bg-red-600 text-white rounded-lg text-sm font-semibold hover:bg-red-700">Delete</button>
    </div>
  </div>
</div>

<!-- Toast -->
<div id="toast" class="fixed bottom-5 right-5 z-50 hidden">
  <div class="bg-gray-900 text-white text-sm font-medium px-4 py-3 rounded-lg shadow-lg flex items-center gap-2">
    <span id="toast-icon"></span><span id="toast-msg"></span>
  </div>
</div>

<script>
let events: any[]  = [];
let editingId: string | null  = null;
let deletingId: string | null = null;
let uploadedCover = { url: null as string | null, key: null as string | null };

function showToast(msg: string, ok = true) {
  const t = document.getElementById('toast')!;
  document.getElementById('toast-icon')!.textContent = ok ? '✅' : '❌';
  document.getElementById('toast-msg')!.textContent  = msg;
  t.classList.remove('hidden');
  setTimeout(() => t.classList.add('hidden'), 3500);
}

function statusColor(s: string) {
  return s === 'published' ? 'bg-green-100 text-green-700'
       : s === 'closed'    ? 'bg-gray-100 text-gray-500'
       : 'bg-amber-100 text-amber-700';
}

function fmtDate(d: string | null) {
  if (!d) return '—';
  return new Date(d).toLocaleDateString('en-PH', { year:'numeric', month:'short', day:'numeric' });
}

async function loadEvents() {
  const res  = await fetch('/api/events?admin=true');
  const data = await res.json();
  events     = data.events ?? [];

  document.getElementById('loading')!.classList.add('hidden');

  const total       = events.length;
  const published   = events.filter(e => e.status === 'published').length;
  const registrants = events.reduce((s: number, e: any) => s + (e.registrationCounts?.total ?? 0), 0);
  const pending     = events.reduce((s: number, e: any) => s + (e.registrationCounts?.pending ?? 0), 0);

  document.getElementById('stat-total')!.textContent       = String(total);
  document.getElementById('stat-published')!.textContent   = String(published);
  document.getElementById('stat-registrants')!.textContent = String(registrants);
  document.getElementById('stat-pending')!.textContent     = String(pending);

  if (total === 0) { document.getElementById('empty')!.classList.remove('hidden'); return; }

  const grid = document.getElementById('events-grid')!;
  grid.classList.remove('hidden');
  grid.innerHTML = events.map(e => `
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-md transition-shadow">
      <div class="relative h-40 bg-gradient-to-br from-purple-100 to-pink-100">
        ${e.coverPhoto
          ? `<img src="${e.coverPhoto}" class="w-full h-full object-cover" alt="${e.title}" />`
          : `<div class="w-full h-full flex items-center justify-center text-4xl">🎵</div>`}
        <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full text-xs font-bold ${statusColor(e.status)} capitalize">${e.status}</span>
      </div>
      <div class="p-4">
        <h3 class="font-bold text-gray-900 truncate">${e.title}</h3>
        ${e.instrument ? `<p class="text-xs text-purple-600 font-medium mt-0.5">🎵 ${e.instrument}</p>` : ''}
        <p class="text-xs text-gray-500 mt-1">📅 ${fmtDate(e.startDate)} – ${fmtDate(e.endDate)}</p>
        <div class="flex items-center gap-2 mt-3">
          <span class="text-xs bg-gray-100 text-gray-600 px-2 py-1 rounded-lg font-medium">${e.registrationCounts?.total ?? 0} registered</span>
          ${(e.registrationCounts?.pending ?? 0) > 0 ? `<span class="text-xs bg-amber-100 text-amber-700 px-2 py-1 rounded-lg font-medium">${e.registrationCounts.pending} pending</span>` : ''}
          ${(e.registrationCounts?.approved ?? 0) > 0 ? `<span class="text-xs bg-green-100 text-green-700 px-2 py-1 rounded-lg font-medium">${e.registrationCounts.approved} approved</span>` : ''}
        </div>
        <div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-100">
          <a href="/admin/events/${e._id}/registrants"
            class="flex-1 text-center text-xs font-semibold text-purple-600 hover:text-purple-700 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-lg transition-colors">
            View Registrants
          </a>
          <button data-edit="${e._id}" class="p-1.5 text-gray-400 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
          </button>
          <button data-delete="${e._id}" data-name="${e.title}" class="p-1.5 text-gray-400 hover:text-red-600 hover:bg-red-50 rounded-lg transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          </button>
        </div>
      </div>
    </div>
  `).join('');

  grid.querySelectorAll('[data-edit]').forEach(btn => {
    btn.addEventListener('click', () => openModal((btn as HTMLElement).dataset.edit ?? null));
  });
  grid.querySelectorAll('[data-delete]').forEach(btn => {
    const el = btn as HTMLElement;
    btn.addEventListener('click', () => openDeleteModal(el.dataset.delete!, el.dataset.name!));
  });
}

function openModal(id: string | null = null) {
  editingId    = id;
  uploadedCover = { url: null, key: null };
  const e      = id ? events.find(ev => ev._id === id) : null;

  (document.getElementById('modal-title') as HTMLElement).textContent          = e ? 'Edit Event' : 'New Event';
  (document.getElementById('f-title') as HTMLInputElement).value               = e?.title ?? '';
  (document.getElementById('f-instrument') as HTMLInputElement).value          = e?.instrument ?? '';
  (document.getElementById('f-status') as HTMLSelectElement).value             = e?.status ?? 'draft';
  (document.getElementById('f-startDate') as HTMLInputElement).value           = e?.startDate ? e.startDate.slice(0,10) : '';
  (document.getElementById('f-endDate') as HTMLInputElement).value             = e?.endDate   ? e.endDate.slice(0,10)   : '';
  (document.getElementById('f-maxSlots') as HTMLInputElement).value            = e?.maxSlots ?? '';
  (document.getElementById('f-location') as HTMLInputElement).value            = e?.location ?? '';
  (document.getElementById('f-schedule') as HTMLInputElement).value            = e?.schedule ?? 'Morning sessions only (8:00 AM – 12:00 PM)';
  (document.getElementById('f-phone') as HTMLInputElement).value               = e?.contactPhone ?? '';
  (document.getElementById('f-contactEmail') as HTMLInputElement).value        = e?.contactEmail ?? '';
  (document.getElementById('f-description') as HTMLTextAreaElement).value      = e?.description ?? '';
  document.getElementById('modal-error')!.classList.add('hidden');

  const preview     = document.getElementById('cover-preview') as HTMLImageElement;
  const placeholder = document.getElementById('cover-placeholder')!;
  if (e?.coverPhoto) {
    preview.src = e.coverPhoto;
    preview.classList.remove('hidden');
    placeholder.classList.add('hidden');
    uploadedCover = { url: e.coverPhoto, key: e.coverPhotoKey ?? null };
  } else {
    preview.classList.add('hidden');
    placeholder.classList.remove('hidden');
  }

  document.getElementById('event-modal')!.classList.remove('hidden');
  document.getElementById('event-modal')!.classList.add('flex');
}

function closeModal() {
  document.getElementById('event-modal')!.classList.add('hidden');
  document.getElementById('event-modal')!.classList.remove('flex');
  editingId = null;
}

document.getElementById('new-event-btn')!.addEventListener('click', () => openModal());
document.getElementById('new-event-btn-2')?.addEventListener('click', () => openModal());
document.getElementById('modal-close')!.addEventListener('click', closeModal);
document.getElementById('modal-cancel')!.addEventListener('click', closeModal);
document.getElementById('modal-backdrop')!.addEventListener('click', closeModal);

// Cover upload
(document.getElementById('cover-input') as HTMLInputElement).addEventListener('change', async (e) => {
  const file = (e.target as HTMLInputElement).files?.[0];
  if (!file) return;
  document.getElementById('upload-progress')!.classList.remove('hidden');
  const fd = new FormData();
  fd.append('file', file);
  try {
    const res  = await fetch('/api/upload/event-cover', { method: 'POST', body: fd });
    const data = await res.json();
    if (data.success) {
      uploadedCover = { url: data.url, key: data.key };
      const preview = document.getElementById('cover-preview') as HTMLImageElement;
      preview.src = data.url;
      preview.classList.remove('hidden');
      document.getElementById('cover-placeholder')!.classList.add('hidden');
      showToast('Cover photo uploaded');
    } else { showToast(data.message, false); }
  } catch { showToast('Upload failed', false); }
  finally { document.getElementById('upload-progress')!.classList.add('hidden'); }
});

// Save
document.getElementById('modal-save')!.addEventListener('click', async () => {
  const title = (document.getElementById('f-title') as HTMLInputElement).value.trim();
  const errEl = document.getElementById('modal-error')!;
  if (!title) { errEl.textContent = 'Title is required'; errEl.classList.remove('hidden'); return; }
  errEl.classList.add('hidden');

  const btn = document.getElementById('modal-save') as HTMLButtonElement;
  btn.textContent = 'Saving...'; btn.disabled = true;

  const maxSlotsVal = (document.getElementById('f-maxSlots') as HTMLInputElement).value;
  const payload: any = {
    title,
    instrument:   (document.getElementById('f-instrument') as HTMLInputElement).value.trim(),
    status:       (document.getElementById('f-status') as HTMLSelectElement).value,
    startDate:    (document.getElementById('f-startDate') as HTMLInputElement).value || null,
    endDate:      (document.getElementById('f-endDate') as HTMLInputElement).value   || null,
    maxSlots:     maxSlotsVal ? Number(maxSlotsVal) : null,
    location:     (document.getElementById('f-location') as HTMLInputElement).value.trim(),
    schedule:     (document.getElementById('f-schedule') as HTMLInputElement).value.trim(),
    contactPhone: (document.getElementById('f-phone') as HTMLInputElement).value.trim(),
    contactEmail: (document.getElementById('f-contactEmail') as HTMLInputElement).value.trim(),
    description:  (document.getElementById('f-description') as HTMLTextAreaElement).value.trim(),
    ...(uploadedCover.url ? { coverPhoto: uploadedCover.url, coverPhotoKey: uploadedCover.key } : {}),
  };

  try {
    const url  = editingId ? `/api/events/${editingId}` : '/api/events';
    const res  = await fetch(url, { method: editingId ? 'PUT' : 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
    const data = await res.json();
    if (data.success) { closeModal(); showToast(editingId ? 'Event updated' : 'Event created'); loadEvents(); }
    else { errEl.textContent = data.message; errEl.classList.remove('hidden'); }
  } catch { errEl.textContent = 'Save failed'; errEl.classList.remove('hidden'); }
  finally { btn.textContent = 'Save Event'; btn.disabled = false; }
});

function openDeleteModal(id: string, name: string) {
  deletingId = id;
  document.getElementById('delete-event-name')!.textContent = name;
  document.getElementById('delete-modal')!.classList.remove('hidden');
  document.getElementById('delete-modal')!.classList.add('flex');
}

document.getElementById('delete-cancel')!.addEventListener('click', () => {
  document.getElementById('delete-modal')!.classList.add('hidden');
  document.getElementById('delete-modal')!.classList.remove('flex');
});

document.getElementById('delete-confirm')!.addEventListener('click', async () => {
  const btn = document.getElementById('delete-confirm') as HTMLButtonElement;
  btn.textContent = 'Deleting...'; btn.disabled = true;
  try {
    const res  = await fetch(`/api/events/${deletingId}`, { method: 'DELETE' });
    const data = await res.json();
    if (data.success) {
      document.getElementById('delete-modal')!.classList.add('hidden');
      document.getElementById('delete-modal')!.classList.remove('flex');
      showToast('Event deleted');
      loadEvents();
    } else { showToast(data.message, false); }
  } catch { showToast('Delete failed', false); }
  finally { btn.textContent = 'Delete'; btn.disabled = false; }
});

loadEvents();
</script>
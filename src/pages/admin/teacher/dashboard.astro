---
import AdminLayout from '../../../layouts/AdminLayout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
if (user.role !== 'teacher') return Astro.redirect('/admin');
---

<AdminLayout title="Teacher Dashboard | YSC" description="Teacher dashboard">
  <div style="max-width:900px;margin:0 auto;">
    <h1 style="font-size:24px;font-weight:800;color:#f1f5f9;margin:0 0 6px;">Teacher Dashboard</h1>
    <p style="font-size:13px;color:#64748b;margin:0 0 16px;">
      Mark today’s sessions and review your past 7 days attendance.
    </p>

    {!user.isApproved && (
      <div style="background:rgba(251,191,36,0.12);border:1px solid rgba(251,191,36,0.22);color:#fde68a;border-radius:14px;padding:12px 14px;">
        Your account is pending approval. An admin must approve your teacher account before you can access teacher tools.
      </div>
    )}

    {user.isApproved && (
      <div style="display:grid;gap:14px;">
        <section style="background:#16162a;border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:18px;">
          <h2 style="margin:0 0 10px;color:#e2e8f0;font-size:16px;">Today&apos;s attendance</h2>
          <div style="overflow:auto;border-radius:12px;border:1px solid rgba(255,255,255,0.06);">
            <table style="width:100%;border-collapse:collapse;font-size:12px;">
              <thead style="background:#11111f;color:#94a3b8;">
                <tr>
                  <th style="text-align:left;padding:10px 12px;">Student</th>
                  <th style="text-align:left;padding:10px 12px;">Subject</th>
                  <th style="text-align:left;padding:10px 12px;">Time</th>
                  <th style="text-align:left;padding:10px 12px;">Status</th>
                  <th style="text-align:right;padding:10px 12px;">Actions</th>
                </tr>
              </thead>
              <tbody id="today-body" style="background:#0d0d1a;color:#cbd5e1;">
                <tr><td colspan="5" style="padding:14px 12px;color:#64748b;">Loading...</td></tr>
              </tbody>
            </table>
          </div>
        </section>

        <section style="background:#16162a;border:1px solid rgba(255,255,255,0.06);border-radius:16px;padding:18px;">
          <h2 style="margin:0 0 10px;color:#e2e8f0;font-size:16px;">Past 7 days summary</h2>
          <div id="summary-cards" style="display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;">
            <div style="background:#11111f;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:12px;">
              <p style="margin:0;color:#64748b;font-size:11px;">Total</p>
              <p id="sum-total" style="margin:4px 0 0;color:#e2e8f0;font-size:22px;font-weight:700;">0</p>
            </div>
            <div style="background:#11111f;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:12px;">
              <p style="margin:0;color:#64748b;font-size:11px;">Attended</p>
              <p id="sum-attended" style="margin:4px 0 0;color:#22c55e;font-size:22px;font-weight:700;">0</p>
            </div>
            <div style="background:#11111f;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:12px;">
              <p style="margin:0;color:#64748b;font-size:11px;">Absent</p>
              <p id="sum-absent" style="margin:4px 0 0;color:#f59e0b;font-size:22px;font-weight:700;">0</p>
            </div>
            <div style="background:#11111f;border:1px solid rgba(255,255,255,0.06);border-radius:12px;padding:12px;">
              <p style="margin:0;color:#64748b;font-size:11px;">Pending</p>
              <p id="sum-pending" style="margin:4px 0 0;color:#60a5fa;font-size:22px;font-weight:700;">0</p>
            </div>
          </div>
        </section>
      </div>
    )}
  </div>

  {user.isApproved && (
    <script>
      const todayBody = document.getElementById('today-body');
      const sumTotal = document.getElementById('sum-total');
      const sumAttended = document.getElementById('sum-attended');
      const sumAbsent = document.getElementById('sum-absent');
      const sumPending = document.getElementById('sum-pending');

      function badge(status) {
        const map = {
          pending: ['Pending', '#60a5fa', 'rgba(96,165,250,0.14)'],
          attended: ['Attended', '#22c55e', 'rgba(34,197,94,0.14)'],
          absent: ['Absent', '#f59e0b', 'rgba(245,158,11,0.14)'],
          cancelled: ['Cancelled', '#94a3b8', 'rgba(148,163,184,0.14)'],
        };
        const [text, fg, bg] = map[status] ?? map.pending;
        return `<span style="display:inline-flex;padding:4px 10px;border-radius:999px;background:${bg};color:${fg};font-weight:700;font-size:11px;">${text}</span>`;
      }

      async function mark(logId, status) {
        const note = status === 'absent' ? window.prompt('Optional note for absence:') ?? '' : '';
        await fetch('/api/attendance/mark', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ logId, status, note }),
        });
        await Promise.all([loadToday(), loadSummary()]);
      }

      async function loadToday() {
        const today = new Date().toISOString().slice(0, 10);
        const res = await fetch(`/api/attendance/log?date=${today}`);
        const data = await res.json().catch(() => ({}));
        if (!data.success) {
          todayBody.innerHTML = `<tr><td colspan="5" style="padding:14px 12px;color:#ef4444;">Failed to load today&apos;s logs.</td></tr>`;
          return;
        }
        const logs = data.logs ?? [];
        if (!logs.length) {
          todayBody.innerHTML = `<tr><td colspan="5" style="padding:14px 12px;color:#64748b;">No sessions for today.</td></tr>`;
          return;
        }
        todayBody.innerHTML = logs.map((log) => `
          <tr style="border-top:1px solid rgba(255,255,255,0.06);">
            <td style="padding:10px 12px;">${log.studentName ?? ''}</td>
            <td style="padding:10px 12px;">${log.subject ?? ''}</td>
            <td style="padding:10px 12px;">${log.time ?? ''}</td>
            <td style="padding:10px 12px;">${badge(log.status)}</td>
            <td style="padding:10px 12px;text-align:right;white-space:nowrap;">
              <button data-action="attended" data-id="${log._id}" style="background:transparent;border:1px solid rgba(255,255,255,0.10);color:#22c55e;border-radius:10px;padding:7px 10px;cursor:pointer;font-size:12px;margin-right:8px;">Mark Attended</button>
              <button data-action="absent" data-id="${log._id}" style="background:transparent;border:1px solid rgba(255,255,255,0.10);color:#f59e0b;border-radius:10px;padding:7px 10px;cursor:pointer;font-size:12px;">Mark Absent</button>
            </td>
          </tr>
        `).join('');
      }

      async function loadSummary() {
        const fromDate = new Date();
        fromDate.setDate(fromDate.getDate() - 6);
        const from = fromDate.toISOString().slice(0, 10);
        const to = new Date().toISOString().slice(0, 10);
        const res = await fetch(`/api/attendance/log?from=${from}&to=${to}`);
        const data = await res.json().catch(() => ({}));
        const logs = data.success ? (data.logs ?? []) : [];
        const total = logs.length;
        const attended = logs.filter((x) => x.status === 'attended').length;
        const absent = logs.filter((x) => x.status === 'absent').length;
        const pending = logs.filter((x) => x.status === 'pending').length;
        sumTotal.textContent = String(total);
        sumAttended.textContent = String(attended);
        sumAbsent.textContent = String(absent);
        sumPending.textContent = String(pending);
      }

      todayBody?.addEventListener('click', async (e) => {
        const btn = e.target?.closest?.('button');
        if (!btn) return;
        const action = btn.getAttribute('data-action');
        const id = btn.getAttribute('data-id');
        if (!action || !id) return;
        if (action === 'attended') await mark(id, 'attended');
        if (action === 'absent') await mark(id, 'absent');
      });

      loadToday();
      loadSummary();
    </script>
  )}
</AdminLayout>


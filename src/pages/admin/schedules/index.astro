---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import SchedulesManager from '../../../components/admin/ScheduleManager.tsx';
import { connectDB } from '../../../lib/db/client.ts';
import  Schedule  from '../../../lib/db/models/Schedule.ts';
import Student from '../../../lib/db/models/Student.ts';

// Protect route - redirect if not logged in
const { userId } = Astro.locals.auth();
if (!userId) return Astro.redirect('/admin/login');

// Fetch initial data server-side so React island has no loading flash
let schedules = [];
let students = [];

try {
  await connectDB();
  const [rawSchedules, rawStudents] = await Promise.all([
    Schedule.find().populate('studentId', 'name telegramChatId phone').sort({ dayOfWeek: 1, time: 1 }).lean(),
    Student.find({ active: true }).sort({ name: 1 }).lean(),
  ]);
  // Serialize: ObjectId → string
  schedules = JSON.parse(JSON.stringify(rawSchedules));
  students  = JSON.parse(JSON.stringify(rawStudents));
} catch (err) {
  console.error('Failed to load schedules:', err);
}
---

<AdminLayout title="Class Schedules | YSC Admin" description="Manage class schedules and Telegram reminders">
  {/* React island — client:load hydrates immediately */}
  <SchedulesManager
    client:load
    initialSchedules={schedules}
    initialStudents={students}
  />
</AdminLayout>
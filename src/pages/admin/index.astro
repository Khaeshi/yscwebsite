---
import AdminLayout from '../../layouts/AdminLayout.astro';

const user = Astro.locals.user;
if (!user) return Astro.redirect('/admin/login');
---

<AdminLayout title="Dashboard | YSC Admin" description="Admin Dashboard">
  <div class="max-w-7xl mx-auto">
    <h1 class="text-2xl sm:text-3xl font-bold mb-5 sm:mb-8">Dashboard</h1>

    <!-- Stats Grid -->
    <div class="grid grid-cols-3 gap-2 sm:gap-4 lg:gap-6 mb-5 sm:mb-8">
      <div class="bg-white rounded-lg border border-gray-200 p-3 sm:p-6">
        <div class="flex items-start sm:items-center justify-between mb-1 sm:mb-2">
          <span class="text-gray-600 text-xs sm:text-sm font-medium leading-tight">Total Students</span>
          <div class="w-7 h-7 sm:w-10 sm:h-10 bg-purple-100 rounded-lg items-center justify-center hidden sm:flex flex-shrink-0">
            <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
        </div>
        <p id="stat-students" class="text-2xl sm:text-3xl font-bold text-gray-900">—</p>
        <p class="text-xs sm:text-sm text-green-600 mt-0.5 sm:mt-1">↑ Active</p>
      </div>

      <div class="bg-white rounded-lg border border-gray-200 p-3 sm:p-6">
        <div class="flex items-start sm:items-center justify-between mb-1 sm:mb-2">
          <span class="text-gray-600 text-xs sm:text-sm font-medium leading-tight">Total Programs</span>
          <div class="w-7 h-7 sm:w-10 sm:h-10 bg-blue-100 rounded-lg items-center justify-center hidden sm:flex flex-shrink-0">
            <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
        </div>
        <p id="stat-programs" class="text-2xl sm:text-3xl font-bold text-gray-900">—</p>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5 sm:mt-1">Courses</p>
      </div>

      <div class="bg-white rounded-lg border border-gray-200 p-3 sm:p-6">
        <div class="flex items-start sm:items-center justify-between mb-1 sm:mb-2">
          <span class="text-gray-600 text-xs sm:text-sm font-medium leading-tight">Enrollments</span>
          <div class="w-7 h-7 sm:w-10 sm:h-10 bg-green-100 rounded-lg items-center justify-center hidden sm:flex flex-shrink-0">
            <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
            </svg>
          </div>
        </div>
        <p id="stat-enrollments" class="text-2xl sm:text-3xl font-bold text-gray-900">—</p>
        <p class="text-xs sm:text-sm text-gray-500 mt-0.5 sm:mt-1">This year</p>
      </div>
    </div>

    <!-- Quick Actions -->
    <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6 mb-5 sm:mb-8">
      <h2 class="text-base sm:text-xl font-bold mb-3 sm:mb-4">Quick Actions</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 sm:gap-4">
        <a href="/admin/students" class="p-3 sm:p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-center">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-purple-100 rounded-lg flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-medium">Add Student</span>
        </a>
        <a href="/admin/schedules" class="p-3 sm:p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-center">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-indigo-100 rounded-lg flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-medium">Schedules</span>
        </a>
        <a href="/admin/programs" class="p-3 sm:p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-center">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-blue-100 rounded-lg flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-medium">Add Program</span>
        </a>
        <a href="/" target="_blank" class="p-3 sm:p-4 border border-gray-200 rounded-lg hover:bg-gray-50 transition-colors text-center">
          <div class="w-10 h-10 sm:w-12 sm:h-12 bg-yellow-100 rounded-lg flex items-center justify-center mx-auto mb-2">
            <svg class="w-5 h-5 sm:w-6 sm:h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
          </div>
          <span class="text-xs sm:text-sm font-medium">View Site</span>
        </a>
      </div>
    </div>

    <!-- Recent Activity -->
    <div class="bg-white rounded-lg border border-gray-200 p-4 sm:p-6">
      <h2 class="text-base sm:text-xl font-bold mb-3 sm:mb-4">Recent Activity</h2>
      <p class="text-gray-500 text-center text-sm py-6 sm:py-8">Recent enrollments and updates will appear here</p>
    </div>
  </div>

  <script>
    // Fetch stats after page renders — no DB blocking
    fetch('/api/stats')
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success) {
          var s = document.getElementById('stat-students');
          var p = document.getElementById('stat-programs');
          var e = document.getElementById('stat-enrollments');
          if (s) s.textContent = String(data.totalStudents);
          if (p) p.textContent = String(data.totalPrograms);
          if (e) e.textContent = String(data.totalEnrollments);
        }
      })
      .catch(function() {
        // silently fail — dashes stay if API errors
      });
  </script>
</AdminLayout>